PORT=5000
NODE_ENV=development
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/cineregal
# For MongoDB Atlas cloud database:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cineregal?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
# Local demo admin only. Override both values before deployment.
ADMIN_LOGIN_ID=admin@123
ADMIN_PASSWORD=admin@123
ADMIN_EMAIL=admin@cineregal.com
ADMIN_JWT_EXPIRE=8h
